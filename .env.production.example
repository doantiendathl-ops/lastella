APP_NAME="Lastella PMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Must be the public HTTPS URL the browser actually loads, not the internal
# 127.0.0.1:8080 address cloudflared forwards to. bootstrap/app.php trusts
# 127.0.0.1 as a proxy (the Cloudflare Tunnel hop) so this scheme is honored
# when Laravel generates route()/redirect() URLs — a mismatch here causes
# https pages to generate http:// links, which browsers block as mixed content.
APP_URL=https://pms.lastella.com.vn

APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<pilot-database-name>
DB_USERNAME=lastella_app
DB_PASSWORD=<strong password, set locally on this machine, never shared in chat>

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Cloudflare Tunnel/HTTPS is active — cookie must be marked Secure so it's
# only ever sent over the encrypted connection.
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

VITE_APP_NAME="${APP_NAME}"
